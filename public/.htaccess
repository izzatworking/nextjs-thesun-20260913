<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On
    RewriteBase /

    # 1. Serve existing .html files for extensionless URLs
    #    e.g. /category/news -> category/news.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]

    # 2. All other URLs -> client-side article shell
    #    The Next.js catch-all route renders any article from the URL slug.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /article-shell.html [L]
</IfModule>