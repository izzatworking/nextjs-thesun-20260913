# WordPress / Site
NEXT_PUBLIC_SITE_URL=https://thesun.my
NEXT_PUBLIC_WORDPRESS_REST_URL=https://thesun.my/wp-json/wp/v2
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://thesun.my/thesun-api
NEXT_PUBLIC_WORDPRESS_REST_ROOT=https://thesun.my/wp-json

# Server-side API keys (jangan dedahkan dengan NEXT_PUBLIC_)
YOUTUBE_API_KEY=your-youtube-data-api-key
FOOTBALL_API_KEY=your-football-api-key
FOOTBALL_API_HOST=v3.football.api-sports.io
FOOTBALL_LEAGUE_ID=1
FOOTBALL_SEASON=2022

# Homepage / fetch config
PINNED_TAG_ID=50048
WP_FETCH_TIMEOUT_MS=20000

# Samba Configuration
SAMBA_SERVER=your-samba-server-ip
SAMBA_SHARE=share-name
SAMBA_USERNAME=your-username
SAMBA_PASSWORD=your-password
SAMBA_DOMAIN=WORKGROUP
SAMBA_PORT=445
